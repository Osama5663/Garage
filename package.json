{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "garage-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "build:server": "esbuild api/_lib/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api_dist/_lib/server.js",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "client:dev": "vite --force",
    "server:dev": "nodemon --verbose",
    "test": "vitest",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config playwright.config.js",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.12",
    "@types/quill": "^2.0.14",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.8.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "docx-preview": "0.3.7",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.263.1",
    "monaco-editor": "^0.44.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "pdfjs-dist": "5.4.449",
    "pdfkit": "^0.17.2",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^9.0.1",
    "vite-tsconfig-paths": "^5.1.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "esbuild": "^0.25.10",
    "jsdom": "^23.0.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.27",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.3.3",
    "tsx": "^4.20.3",
    "typescript": "5.3.3",
    "vite": "^4.4.5",
    "vitest": "^1.0.4"
  }
}
